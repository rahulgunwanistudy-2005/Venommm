{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "venomgap-api",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "venomgap.api"
      ],
      "port": 8010,
      "autoPort": true
    },
    {
      "name": "venomgap-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev"
      ],
      "port": 5173,
      "autoPort": true
    }
  ]
}
